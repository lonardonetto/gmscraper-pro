{
  "name": "gms-keygen",
  "version": "1.0.0",
  "description": "GMScraper Pro License Key Generator",
  "main": "keygen-cli.js",
  "bin": "keygen-cli.js",
  "scripts": {
    "build": "node embed-wasm.js && pkg keygen-cli.js --target node18-win-x64 --output dist/keygen.exe",
    "install-pkg": "npm install -g pkg"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "pkg": {
    "assets": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "targets": ["node18-win-x64"]
  }
}
