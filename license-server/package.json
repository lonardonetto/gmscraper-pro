{
  "name": "gms-license-server",
  "version": "1.0.0",
  "description": "GMScraper Pro License Validation Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "keygen": "node keygen.js",
    "keygen:list": "node keygen.js --list",
    "build:keygen": "node embed-wasm.js && pkg keygen-cli.js --target node18-win-x64 --output dist/keygen.exe"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
