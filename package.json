{
  "name": "gmap-scraper-pro",
  "version": "1.0.0",
  "description": "Google Maps Scraper Pro - Commercial Desktop App",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "build": "electron-builder build --win --mac",
    "build:win": "electron-builder build --win",
    "build:mac": "electron-builder build --mac",
    "build:dir": "electron-builder build --win --dir",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": ["google-maps", "scraper", "electron"],
  "author": "GMScraper Pro",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "axios": "^1.6.7",
    "sql.js": "^1.12.0",
    "csv-writer": "^1.6.0",
    "electron-log": "^5.1.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.8",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "node-machine-id": "^1.1.12",
    "playwright": "^1.42.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "crypto-js": "^4.2.0",
    "https-proxy-agent": "^7.0.4",
    "socks-proxy-agent": "^8.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.gmscraperpro.app",
    "productName": "GMScraper Pro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "GMScraper Pro",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GMScraper Pro"
    },
    "publish": null
  }
}
